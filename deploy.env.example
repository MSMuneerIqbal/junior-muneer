# Copy to deploy.env on the server and fill in (deploy.env is never committed).

# Your domain or subdomain, pointed at the server's IP (an A record), e.g. junior.example.com
DOMAIN=

# The login the dashboard asks for.
LOGIN_USER=muneer
# Not the password itself: its hash. Make it on the server with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# and paste the result here, inside single quotes (it contains $ signs), e.g.
#   LOGIN_PASSWORD_HASH='$2a$14$...'
LOGIN_PASSWORD_HASH=
