# Copy this file to .env and fill in your own values. Never commit .env.

# OpenAI API key (needed from P0-06). Paste it yourself.
OPENAI_API_KEY=

# Optional: DeepSeek API key, to use DeepSeek's cheaper text models (Settings -> Models).
DEEPSEEK_API_KEY=

# Where the database, backups and uploads live (relative to the repo root).
DATA_DIR=data

# Logging: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Only change these if the ports are taken.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Background jobs such as the daily backup. Leave on.
SCHEDULER_ENABLED=true

# true = a fake AI that echoes your messages (no key, no cost). For trying the dashboard.
FAKE_AI=false

# Optional: free key from artificialanalysis.ai (Insights Platform -> API key) for live AI rankings
# ("who's on top" in coding, reasoning, voice, image and video) in the AI news.
ARTIFICIAL_ANALYSIS_API_KEY=

# Your Gmail, for the daily top 5 AI news by email. Paste these yourself: your address, and a Google
# App Password from https://myaccount.google.com/apppasswords (needs 2-Step Verification; never your real password).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Google Docs, Sheets and Calendar: your Google Cloud project's OAuth client (type "Web application", with
# the redirect URI below added). Paste these yourself, then use Connect Google in Settings -> Connections.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/google/callback

# Phase 8: WhatsApp. Don't type these by hand: run connect.bat whatsapp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_OWNER_NUMBER=
# A fixed address for WhatsApp on your PC (tunnel.bat): from your free ngrok account.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Phase 6: the app's GitHub OAuth App client ID (TASK.md, P6-01). People then connect GitHub in the app.
GITHUB_CLIENT_ID=
# Or, on your own machine: run connect.bat github (a token, or your GitHub CLI login).
GITHUB_TOKEN=
GITHUB_AUTH=
GITHUB_USER=

# Phase 3: your Facebook Page. Don't type these by hand: run connect.bat meta (it fills them in).
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_TOKEN=
