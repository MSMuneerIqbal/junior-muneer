# Copy this file to .env and fill in your own values. Never commit .env.

# OpenAI API key (needed from P0-06). Paste it yourself.
OPENAI_API_KEY=

# Where the database, backups and uploads live (relative to the repo root).
DATA_DIR=data

# Logging: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Only change these if the ports are taken.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Background jobs such as the daily backup. Leave on.
SCHEDULER_ENABLED=true
