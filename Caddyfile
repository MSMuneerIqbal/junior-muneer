# One address for everything, with HTTPS (Caddy gets the certificate by itself) and a login.
{$DOMAIN} {
	encode gzip

	# Meta delivers WhatsApp messages here and can't log in: the backend checks Meta's signature instead.
	handle /api/whatsapp/webhook {
		reverse_proxy backend:8000
	}

	handle {
		# Everything else needs your login; the browser remembers it for the API and the chat too.
		basic_auth {
			{$LOGIN_USER} {$LOGIN_PASSWORD_HASH}
		}
		@backend path /api/* /ws/* /health
		reverse_proxy @backend backend:8000
		reverse_proxy frontend:3000
	}
}
